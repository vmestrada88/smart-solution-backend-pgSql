# ========================================
# Backend Environment Variables for Koyeb
# ========================================

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=5000

# Frontend URL (CORS)
FRONTEND_URL=https://your-frontend-app.koyeb.app

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars

# ========================================
# Database Configuration
# ========================================

# RECOMMENDED: Use DATABASE_URL for Koyeb PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/database

# ALTERNATIVE: Individual database settings
# DB_HOST=your-db-host.com
# DB_PORT=5432
# DB_NAME=smartsolution_production
# DB_USER=postgres
# DB_PASSWORD=your-secure-password
# DB_SSL=true

# ========================================
# Optional Settings
# ========================================

# File Upload Settings
# MAX_FILE_SIZE=5242880
# UPLOAD_PATH=./uploads

# ========================================
# Development Settings (local only)
# ========================================
# NODE_ENV=development
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smartsolution_development
# DB_USER=postgres
# DB_PASSWORD=admin123
# FRONTEND_URL=http://localhost:5173
