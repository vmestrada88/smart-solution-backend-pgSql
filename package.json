{
  "name": "smart-ops-backend",
  "version": "0.0.1",
  "main": "server.js",
  "type": "commonjs",
  "author": "Victor Estrada",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:remote": "nodemon server.js --remote",
    "start:remote": "node server.js --remote",
    "sync": "node syncModels.js",
    "test": "jest --coverage --passWithNoTests",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "clean": "rm -rf node_modules/ && rm package-lock.json && npm install",
    "prepare": "husky"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "semver": "^7.7.3",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "lint-staged": "^16.2.3",
    "supertest": "^7.1.4"
  },
  "lint-staged": {
    "*.js": [
      "npm run test:ci"
    ]
  },
  "license": "MIT"
}
