# ========================================
# Backend Production Environment - Koyeb
# ========================================

# Node Environment
NODE_ENV=production

# Server Port
PORT=5000

# ========================================
# Database Configuration
# IMPORTANTE: Usa DATABASE_URL de Koyeb PostgreSQL
# ========================================
# DATABASE_URL se configurará como variable de entorno en Koyeb
# DATABASE_URL=postgresql://user:password@host:port/database

# Fallback para DB individual (no recomendado, usa DATABASE_URL)
# DB_HOST=your-db-host.koyeb.app
# DB_PORT=5432
# DB_NAME=smartsolution_production
# DB_USER=postgres
# DB_PASSWORD=your-password
DB_SSL=true

# ========================================
# CORS Configuration
# ========================================
FRONTEND_URL=https://smartsolutionfl.com
FRONTEND_URLS=https://smartsolutionfl.com,https://www.smartsolutionfl.com

# ========================================
# JWT Secret
# IMPORTANTE: Configura esto como variable de entorno en Koyeb
# ========================================
# JWT_SECRET se configurará como variable de entorno en Koyeb
# JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
